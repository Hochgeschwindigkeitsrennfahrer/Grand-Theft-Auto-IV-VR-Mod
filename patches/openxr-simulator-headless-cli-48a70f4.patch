+static void NeutralizeControllerInputs(ControllerState& controller) {
+    controller.triggerPressed = false;
+    controller.gripPressed = false;
+    controller.menuPressed = false;
+    controller.primaryPressed = false;
+    controller.secondaryPressed = false;
+    controller.thumbstickPressed = false;
+    controller.triggerValue = 0.0f;
+    controller.gripValue = 0.0f;
+    controller.thumbstick = {0.0f, 0.0f};
+}
+
+static bool IsControllerCommandActive(ControllerState& controller, const char* handName) {
+    if (!controller.commandActive) return false;
+    const ULONGLONG now = GetTickCount64();
+    if (controller.commandExpiresAt != 0 && now >= controller.commandExpiresAt) {
+        NeutralizeControllerInputs(controller);
+        controller.commandActive = false;
+        controller.commandExpiresAt = 0;
+        Logf("[SimXR] Controller command lease expired: hand=%s sequence=%llu; inputs neutralized",
+             handName, (unsigned long long)controller.commandSequence);
+        return false;
+    }
+    return true;
+}
