+inline uint64_t ParseJsonUInt64(const char* json, const char* key, uint64_t defaultVal) {
+    char searchKey[64];
+    snprintf(searchKey, sizeof(searchKey), "\"%s\"", key);
+    const char* pos = strstr(json, searchKey);
+    if (!pos) return defaultVal;
+    pos = strchr(pos, ':');
+    if (!pos) return defaultVal;
+    pos++;
+    while (*pos == ' ' || *pos == '\t') pos++;
+    char* end = nullptr;
+    const unsigned long long parsed = strtoull(pos, &end, 10);
+    return end == pos ? defaultVal : (uint64_t)parsed;
+}
+
+inline bool ParseJsonBool(const char* json, const char* key, bool defaultVal) {
+    char searchKey[64];
+    snprintf(searchKey, sizeof(searchKey), "\"%s\"", key);
+    const char* pos = strstr(json, searchKey);
+    if (!pos) return defaultVal;
+    pos = strchr(pos, ':');
+    if (!pos) return defaultVal;
+    pos++;
+    while (*pos == ' ' || *pos == '\t') pos++;
+    if (_strnicmp(pos, "true", 4) == 0 || *pos == '1') return true;
+    if (_strnicmp(pos, "false", 5) == 0 || *pos == '0') return false;
+    return defaultVal;
+}
