+// Command-line/headless integration is strictly opt-in. With no environment
+// variables set, focus and preview behavior remain byte-for-byte equivalent to
+// upstream behavior.
+static bool IsEnvironmentFlagEnabled(const char* name) {
+    char value[32]{};
+    const DWORD length = GetEnvironmentVariableA(name, value, (DWORD)sizeof(value));
+    if (length == 0 || length >= sizeof(value)) return false;
+    return _stricmp(value, "1") == 0 ||
+           _stricmp(value, "true") == 0 ||
+           _stricmp(value, "yes") == 0 ||
+           _stricmp(value, "on") == 0;
+}
+
+static bool IsHeadlessMode() {
+    static const bool enabled = IsEnvironmentFlagEnabled("OPENXR_SIMULATOR_HEADLESS");
+    return enabled;
+}
+
+static const std::string& GetExternalFocusExecutable() {
+    static const std::string executable = []() {
+        char value[MAX_PATH]{};
+        const DWORD length = GetEnvironmentVariableA(
+            "OPENXR_SIMULATOR_EXTERNAL_FOCUS_EXE", value, (DWORD)sizeof(value));
+        if (length == 0 || length >= sizeof(value)) return std::string{};
+        const char* file = value;
+        if (const char* slash = strrchr(value, '\\')) file = slash + 1;
+        if (const char* slash = strrchr(file, '/')) file = slash + 1;
+        return std::string(file);
+    }();
+    return executable;
+}
+
+static bool ForegroundMatchesExternalFocusExecutable(HWND foregroundWindow) {
+    const std::string& wanted = GetExternalFocusExecutable();
+    if (wanted.empty() || !foregroundWindow) return false;
+
+    DWORD processId = 0;
+    GetWindowThreadProcessId(foregroundWindow, &processId);
+    if (processId == 0) return false;
+
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, processId);
+    if (!process) return false;
+    char imagePath[MAX_PATH]{};
+    DWORD imagePathLength = (DWORD)sizeof(imagePath);
+    const BOOL queried = QueryFullProcessImageNameA(process, 0, imagePath, &imagePathLength);
+    CloseHandle(process);
+    if (!queried) return false;
+
+    const char* file = imagePath;
+    if (const char* slash = strrchr(imagePath, '\\')) file = slash + 1;
+    if (const char* slash = strrchr(file, '/')) file = slash + 1;
+    return _stricmp(file, wanted.c_str()) == 0;
+}
+
+static bool IsLogicalFocusForeground() {
+    // A hidden command-line session has no user-facing window to focus. It is
+    // deliberately FOCUSED from xrBeginSession onward so the OpenXR host can
+    // become ready before the external game process exists.
+    if (IsHeadlessMode()) return true;
+
+    const HWND foregroundWindow = GetForegroundWindow();
+    if (!foregroundWindow) return false;
+    if (foregroundWindow == g_session.hwnd) return g_session.isFocused.load();
+    return ForegroundMatchesExternalFocusExecutable(foregroundWindow);
+}
+
+static bool IsInputFocusForeground() {
+    // Headless sessions are CLI-controlled. They stay logically XR-focused,
+    // but must never reinterpret GTA's physical keyboard as XR controller
+    // input.
+    if (IsHeadlessMode()) return false;
+    const HWND foregroundWindow = GetForegroundWindow();
+    if (!foregroundWindow) return false;
+    if (foregroundWindow == g_session.hwnd) return g_session.isFocused.load();
+    DWORD processId = 0;
+    GetWindowThreadProcessId(foregroundWindow, &processId);
+    if (processId != 0 && processId == GetCurrentProcessId()) return true;
+    return ForegroundMatchesExternalFocusExecutable(foregroundWindow);
+}
