## Ignore
/.vs/
/out/
/out-asi/
/out-openxr/
/out-win32/
/build/
/bin/
/backups/
/vendor/
/inspiration/
*.user
*.suo
*.obj
*.pdb
*.dll
*.exe
*.asi
*.log
.DS_Store

# Local game config overrides (keep examples)
/config/dxvk.conf.gpl-off
/config/dxvk.conf.hide-nvidia-off

# Nested clones — use submodules / fetch scripts instead of vendoring blobs
/thirdparty/openvr/
/thirdparty/minhook/
/thirdparty/openxr-sdk/

# Submodule content is tracked via gitlink; ignore local build artifacts inside dxvk
/dxvk/build/
/dxvk/**/Release/
/dxvk/**/Debug/
/dxvk/build.w32/
