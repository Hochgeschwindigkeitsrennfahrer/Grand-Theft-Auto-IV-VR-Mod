## Ignore
/.vs/
/out/
/out-asi/
/out-win32/
/build/
/bin/
/backups/
/vendor/
/inspiration/
/inspo/scripthook_dl/
/thirdparty/dxvk-gplasync/
/dist/*.zip
*.user
*.suo
*.obj
*.pdb
*.dll
*.exe
*.asi
*.log
.DS_Store

# Mode 170 runnable drop (stock DXVK + ASI + OpenVR only; no Rockstar assets)
!prebuilt/mode170/drop-into-GTAIV/*.dll
!prebuilt/mode170/drop-into-GTAIV/*.asi
!prebuilt/mode170/drop-into-GTAIV/d3d9.dll.stock-302

# Local game config overrides (keep examples)
/config/dxvk.conf.gpl-off
/config/dxvk.conf.hide-nvidia-off

# Nested clones — use submodules / fetch scripts instead of vendoring blobs
/thirdparty/openvr/
/thirdparty/minhook/

# Submodule content is tracked via gitlink; ignore local build artifacts inside dxvk
/dxvk/build/
/dxvk/**/Release/
/dxvk/**/Debug/
/dxvk/build.w32/
